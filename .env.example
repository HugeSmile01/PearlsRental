# Copy to .env and update values for your environment
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-this-to-a-long-secret"
NEXTAUTH_URL="http://localhost:3000"
RESERVATION_EXPIRY_HOURS=24

# For local builds only: set to true to allow SQLite while NODE_ENV=production
SKIP_SQLITE_PRODUCTION_CHECK=true
